# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── Weather API ──────────────────────────────────────────────────────────────
# Open-Meteo is free and keyless; this is just the base URL
WEATHER_API_BASE=https://api.open-meteo.com/v1

# ── IBM watsonx.ai ───────────────────────────────────────────────────────────
# Required for the narrative/explanation layer (Phase 4).
# Leave as placeholders until credentials are available.
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_SERVER_PORT=8001

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_API_BASE_URL=http://localhost:8001
